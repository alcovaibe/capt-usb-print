<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />
    <queries>
        <package android:name="org.telegram.messenger" />
    </queries>
    <application
        android:name=".CaptApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CaptUsbPrint">
        <service android:name=".queue.PrintQueueService" android:exported="false"
            android:foregroundServiceType="connectedDevice" android:stopWithTask="false" />
        <activity android:name=".queue.PrintQueueActivity" android:exported="false"
            android:label="@string/queue_title" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reportprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/report_file_paths" />
        </provider>
        <receiver
            android:name=".usb.UsbPermissionReceiver"
            android:enabled="true"
            android:exported="false" />
        <activity
            android:name=".DocumentActivity"
            android:exported="true"
            android:label="@string/document_title">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

