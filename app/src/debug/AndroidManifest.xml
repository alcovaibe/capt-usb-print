<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service android:name=".OfficeSandboxTestService" android:exported="false" android:process=":office" android:stopWithTask="true" />
        <service android:name=".OfficeFileLimitTestService" android:exported="false" android:process=":office" android:stopWithTask="true" />
        <service android:name=".OfficeCpuLimitTestService" android:exported="false" android:process=":office" android:stopWithTask="true" />
        <service android:name=".OfficeAddressLimitTestService" android:exported="false" android:process=":office" android:stopWithTask="true" />
        <activity android:name=".OfficePreviewTestActivity" android:exported="false" />
        <service android:name=".OfficePreviewTestWorkerService" android:exported="false"
            android:process=":office" android:stopWithTask="true" />
        <service android:name=".OfficeAdmissionWorkerService" android:exported="false"
            android:process=":office" android:stopWithTask="true" />
        <service android:name=".OfficeFaultWorkerService" android:exported="false"
            android:process=":office" android:stopWithTask="true" />
    </application>
    <instrumentation android:name="com.cryonum.captusbprint.OfficeSandboxSmoke"
        android:targetPackage="${applicationId}" android:label="Kernel file broker and log privacy, no USB" />
    <instrumentation android:name="com.cryonum.captusbprint.OfficeKernelLimitsSmoke"
        android:targetPackage="${applicationId}" android:label="Kernel limits in disposable workers, no USB" />
    <instrumentation android:name="com.cryonum.captusbprint.OfficePreviewUiSmoke"
        android:targetPackage="${applicationId}" android:label="Synthetic Office UI lifecycle without USB" />
    <instrumentation android:name="com.cryonum.captusbprint.OfficeWorkerLifecycleSmoke"
        android:targetPackage="${applicationId}" android:label="Synthetic worker lifecycle checks without USB" />
    <instrumentation android:name="com.cryonum.captusbprint.PreparedPdfSmoke"
        android:targetPackage="${applicationId}" android:label="Final mixed-A4 PDF layout checks without USB" />
    <instrumentation android:name="com.cryonum.captusbprint.OfficeIntakeSmoke"
        android:targetPackage="${applicationId}" android:label="Office rejection and private import cleanup checks" />
    <instrumentation android:name="com.cryonum.captusbprint.StageCRasterSmoke"
        android:targetPackage="${applicationId}" android:label="Offline Stage C renderer checks" />
    <instrumentation android:name="com.cryonum.captusbprint.StageDPrintSmoke"
        android:targetPackage="${applicationId}" android:label="Offline system PDF and PrintService checks" />
    <instrumentation android:name="com.cryonum.captusbprint.UpdateSmoke"
        android:targetPackage="${applicationId}" android:label="Offline update UI and FileProvider checks" />
</manifest>
